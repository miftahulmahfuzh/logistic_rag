# Copy to .env.local and fill in. Never commit .env.local.
# Text LLM (answering, judging): Anthropic-compatible Messages API.
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_MODEL=glm-5.3
# Vision LLM (charts, KPI cards, scans): OpenAI-style chat completions. Same key.
# glm-5.3 is text-only; the Anthropic-compatible route does not read images.
VISION_BASE_URL=https://api.z.ai/api/coding/paas/v4
VISION_MODEL=glm-4.6v
